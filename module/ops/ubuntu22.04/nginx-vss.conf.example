# Nginx Reverse Proxy Configuration Example for Vision Snapshot & VSS Server
# Target location: /etc/nginx/sites-available/vision-vss.conf

upstream snapshot_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

upstream admin_web_portal {
    server 127.0.0.1:4180;
    keepalive 16;
}

upstream vss_indexer {
    server 127.0.0.1:8200;
    keepalive 32;
}

# 1. Admin Web Portal (:4180)
server {
    listen 4180;
    server_name _;

    # Optional: Basic Auth or OAuth2-Proxy integration
    # auth_basic "Vision Snapshot Admin";
    # auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        proxy_pass http://admin_web_portal;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 2. Main API & Frontend Proxy (:80 / :443)
server {
    listen 80;
    server_name _;

    # Snapshot Backend API
    location /v1/ {
        proxy_pass http://snapshot_backend/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Embedded Admin Web Direct Mount
    location /admin/ {
        proxy_pass http://snapshot_backend/admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # GitHub Webhook Endpoints (/postrecive, /postreceive)
    location ~ ^/(postrecive|postreceive|webhooks) {
        proxy_pass http://snapshot_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health Check
    location /health {
        proxy_pass http://snapshot_backend/v1/health;
    }
}

