[Unit]
Description=Execute fixed VSS module service restart request
After=network.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/vss-module-ops/restart_module_services.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/vss-ops
