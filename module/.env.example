VISION_ENVIRONMENT=development
APP_NAME=Vision Snapshot Backend
API_PREFIX=/v1
LOG_LEVEL=INFO
DOCS_ENABLED=true
# 동일 인스턴스 운영 DSN의 host는 127.0.0.1을 사용하고 실제 계정정보는 별도 secret로 주입합니다.
DATABASE_URL=
# Mutable managed Repository working copies and internal bare Git object cache.
SNAPSHOT_REPOSITORY_ROOT=./data/repos
# Immutable exact revision artifacts supplied to VSS /index.
SNAPSHOT_MATERIALIZATION_ROOT=./data/snapshots
SNAPSHOT_GIT_COMMAND_TIMEOUT_SECONDS=60
# 수동·정기 Repository sync가 공유하는 DB lease입니다. Git command timeout보다 길어야 합니다.
SNAPSHOT_COLLECTION_SYNC_LEASE_SECONDS=300
SNAPSHOT_RECOVERY_ON_STARTUP=true
SNAPSHOT_RECOVERY_BATCH_SIZE=100
# Optional/future provenance pull API에서 VSS가 사용할 inbound 전용 token입니다.
SNAPSHOT_VSS_API_TOKEN=
# Admin Web BFF만 사용하는 Backend 인증 값입니다. 서로 다른 32-byte 이상 secret을 주입합니다.
SNAPSHOT_ADMIN_SERVICE_TOKEN=
SNAPSHOT_ADMIN_IDENTITY_SECRET=
SNAPSHOT_ADMIN_SIGNATURE_MAX_AGE_SECONDS=60
VSS_BASE_URL=http://127.0.0.1:8200
VSS_TOKEN=
VSS_CONNECT_TIMEOUT_SECONDS=2
VSS_READ_TIMEOUT_SECONDS=10
VSS_EXPECTED_SOURCE_REVISION=

# 독립 Admin Web(4180). 운영에서는 별도 /etc/vss-snapshot/admin-web.env로 분리합니다.
ADMIN_WEB_USERS_FILE=/etc/vss-snapshot/admin-users.json
ADMIN_WEB_SESSION_SECRET=
ADMIN_WEB_BACKEND_URL=http://127.0.0.1:8000
ADMIN_WEB_BACKEND_SERVICE_TOKEN=
ADMIN_WEB_BACKEND_SIGNING_SECRET=
ADMIN_WEB_ALLOWED_ORIGINS=https://admin.example.com
ADMIN_WEB_SECURE_COOKIES=true
ADMIN_WEB_MAX_REQUEST_BODY_BYTES=1048576
