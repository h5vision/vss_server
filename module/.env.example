VISION_ENVIRONMENT=development
APP_NAME=Vision Snapshot Backend
API_PREFIX=/v1
LOG_LEVEL=INFO
DOCS_ENABLED=true

# 동일 인스턴스 운영 DSN의 host는 127.0.0.1을 사용하고 실제 계정정보는 별도 secret로 주입합니다.
DATABASE_URL=postgresql+asyncpg://snapshot_user:secret@127.0.0.1:5432/vision_rag

# 불변 Git Revision 트리 승격 루트 디렉터리 경로입니다.
SNAPSHOT_MATERIALIZATION_ROOT=./data/snapshots

# Git 원격 브랜치 수집 bare mirror 및 캐시 디렉터리 경로입니다.
SNAPSHOT_COLLECTION_ROOT=./data/collection

SNAPSHOT_GIT_COMMAND_TIMEOUT_SECONDS=60
SNAPSHOT_RECOVERY_ON_STARTUP=true
SNAPSHOT_RECOVERY_BATCH_SIZE=100

# VSS가 loopback 내부 source API를 호출할 때 사용하는 inbound 전용 token입니다.
SNAPSHOT_VSS_API_TOKEN=

# 관리자 API (/v1/admin/*) 및 Admin Web 인증 토큰입니다.
SNAPSHOT_ADMIN_API_TOKEN=

# VSS 서버 연결 정보 (동일 인스턴스 loopback :8200)
VSS_BASE_URL=http://127.0.0.1:8200
VSS_TOKEN=
VSS_CONNECT_TIMEOUT_SECONDS=2
VSS_READ_TIMEOUT_SECONDS=10
VSS_EXPECTED_SOURCE_REVISION=

# 독립 Admin Web 서버 설정 (포트 4180)
ADMIN_WEB_PORT=4180
ADMIN_WEB_HOST=0.0.0.0
