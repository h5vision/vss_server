VISION_ENVIRONMENT=development
APP_NAME=Vision Snapshot Backend
API_PREFIX=/v1
LOG_LEVEL=INFO
DOCS_ENABLED=true
DATABASE_URL=
SNAPSHOT_MATERIALIZATION_ROOT=./data/snapshots
VSS_MODULE_NAME=vss.indexer
VSS_SOURCE_REVISION=
VSS_JOB_STALE_SECONDS=300

# vss_server reads its own VSS_* settings at module import time.
VSS_STORE=chroma
VSS_DATA_DIR=./data/vss
VSS_OLLAMA_URL=http://127.0.0.1:11434
VSS_PG_DSN=
VSS_PG_SCHEMA=rag
